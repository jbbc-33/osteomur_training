{
  "name": "osteomur-training",
  "version": "1.0.0",
  "description": "App de entrenamiento personal - Vista Cliente y Panel Entrenador (OSTEOMUR)",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node db/seed.js",
    "reset": "node db/reset.js",
    "test": "node test-api.js",
